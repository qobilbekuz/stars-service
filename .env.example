# ============================================================
#  stars-service — muhit sozlamalari
#  Nusxa oling:  cp .env.example .env
# ============================================================

# --- App ---
APP_NAME=stars-service
ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                  # production'da true qiling
API_PREFIX=/v1
CORS_ORIGINS=["*"]

# --- Xavfsizlik ---
# Admin kalit: API-kalit yaratish/o'chirish uchun. Majburiy o'zgartiring!
ADMIN_API_KEY=change-me-super-secret-admin-key
# Webhook imzolash uchun global fallback secret
WEBHOOK_SECRET=change-me-webhook-secret

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stars
POSTGRES_PASSWORD=stars_password
POSTGRES_DB=stars_service
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Rate limit (API-kalit bo'yicha) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- Order processing ---
ORDER_MAX_ATTEMPTS=3
ORDER_RETRY_BACKOFF_SECONDS=30
ORDER_JOB_TIMEOUT_SECONDS=180
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_SECONDS=15

# ============================================================
#  PROVAYDERLAR
#  DEFAULT_PROVIDER: mock | fragment | botapi
#  mock     -> dev/test uchun, hech qanday tashqi chaqiruv yo'q
#  fragment -> fragment-api-lib (TON seed phrase + Fragment cookies)
#  botapi   -> rasmiy Telegram Bot API (bot star balansidan gift/premium)
# ============================================================
DEFAULT_PROVIDER=mock

# --- Fragment provayderi ---
FRAGMENT_ENABLED=false
# 24 so'zli TON hamyon seed-fraza (to'lov shu hamyondan yechiladi)
FRAGMENT_SEED=
# Fragment.com'dan eksport qilingan cookie'lar (KYC rejimi uchun; JSON string)
FRAGMENT_COOKIES=
# KYC rejimi: true bo'lsa buy_stars/buy_premium, false bo'lsa *_without_kyc
FRAGMENT_KYC=false
# Jo'natuvchi ismi ko'rinsinmi (faqat KYC rejimida)
FRAGMENT_SHOW_SENDER=false

# --- Telegram Bot API provayderi ---
BOTAPI_ENABLED=false
BOT_TOKEN=
BOTAPI_BASE_URL=https://api.telegram.org

# --- Limitlar (biznes qoidalari) ---
MIN_STARS=50
MAX_STARS=1000000
ALLOWED_PREMIUM_MONTHS=[3,6,12]

# --- Pul xavfsizligi ---
# To'lov so'rovidan keyingi timeout/uzilishda avtomatik qayta urinish.
# false (tavsiya) -> buyurtma failed bo'ladi, operator qo'lda tekshiradi.
# true            -> avtomatik retry, lekin IKKI MARTA TO'LOV riski bor.
RETRY_ON_NETWORK_TIMEOUT=false
